BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Keep this value permanent. v5 also derives the local token-encryption key from it.
OAUTH_STATE_SECRET=PASTE_RANDOM_SECRET_HERE

GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
DATABASE_FILE=data/bot.db
# v4 file is only used once for automatic migration, if it exists.
GOOGLE_CREDENTIALS_FILE=data/google_credentials.json

GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Fallback for users who have not chosen a personal timezone yet.
# User-entered dates/times are NEVER interpreted using the selected calendar timezone.
USER_TIMEZONE=Europe/Moscow
DEFAULT_EVENT_DURATION_MINUTES=60
